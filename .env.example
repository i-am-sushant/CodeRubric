# CodeRubric Environment Configuration
# Copy this file to .env and fill in your values

# Embeddings: local sentence-transformers (no key needed)
# Override model with EMBEDDING_MODEL=<any sentence-transformers model name>
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# OpenAI (only required if LLM_API_TYPE=openai)
# OPENAI_API_KEY=sk-your-openai-api-key-here

# LLM Configuration (for code review)
# --- Gemini (free tier) ---
# LLM_API_KEY=your-gemini-api-key
# LLM_API_TYPE=google
# MODEL=gemini-1.5-flash
# --- Mistral via OpenRouter (free models available) ---
# LLM_API_KEY=your-openrouter-api-key
# LLM_API_TYPE=openai
# MODEL=mistralai/mistral-7b-instruct
# --- OpenAI ---
LLM_API_KEY=sk-your-llm-api-key-here
LLM_API_TYPE=google
MODEL=gemini-2.0-flash

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/coderubric

# Redis (for background tasks)
REDIS_URL=redis://localhost:6379/0

# Vector Store (ChromaDB)
VECTOR_STORE_PATH=~/.coderubric/chroma_db

# Repository clone storage (persistent across restarts)
REPO_CLONE_PATH=./data/repos

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Security (change in production!)
SECRET_KEY=your-super-secret-key-change-this

# Azure specific (for deployment)
AZURE_STORAGE_ACCOUNT=your-storage-account
AZURE_STORAGE_KEY=your-storage-key
